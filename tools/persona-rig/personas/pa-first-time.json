{
  "description": "A non-technical first-time owner with one provider key: onboarding settings, a first chat, a memory, a file, and recovery after a restart. A Mistral key rides the Z.ai rows so hosted memory has an embedding route, as in the parity eval.",
  "vars": {"suffix": "3107"},
  "matrix": [
    {"name": "mistral-large-4-0", "host": "mistral", "key": "MISTRAL_API_KEY", "model": "mistral-large-4-0", "mem_defect": "", "mem_may": false, "tools_defect": ""},
    {"name": "glm-5.3", "host": "zai", "key": "Z_AI_TOKEN", "model": "glm-5.3", "mem_defect": "", "mem_may": true, "tools_defect": ""},
    {"name": "glm-5.3-flash", "host": "zai", "key": "Z_AI_TOKEN", "model": "glm-5.3-flash", "mem_defect": "", "mem_may": true, "tools_defect": ""}
  ],
  "persona": {
    "name": "pa-first-${name}",
    "display_name": "Marta's Nimbus",
    "timezone": "Europe/Berlin",
    "directive": "You help Marta, who is not technical. Answer in one or two short, plain sentences. Never use jargon.",
    "monthly_cap_cents": 600,
    "keys": {"mistral": "MISTRAL_API_KEY", "${host}": "${key}"},
    "models": {"head": {"${host}": "${model}"}, "sub": {"${host}": "${model}"}},
    "host": "${host}",
    "scenarios": [
      {"id": "onboarding", "steps": [
        {"http": {"method": "GET", "path": "/api/state"},
         "expect": [{"http_status": 200}, {"body_contains": "Marta's Nimbus"}, {"body_contains": "Europe/Berlin"}]},
        {"http": {"method": "GET", "path": "/api/orch"},
         "expect": [{"http_status": 200}, {"body_regex": "${model}"}]}
      ]},
      {"id": "first-chat", "steps": [
        {"say": "Hi! What is 12 times 4? Answer with just the number.",
         "expect": [{"turn_resolved": true}, {"reply_regex": "\\b48\\b"}, {"no_error_reply": true, "known_defect": "${tools_defect}", "may_pass": true}]}
      ]},
      {"id": "memory", "steps": [
        {"say": "Please remember permanently: my dog is called Biscuit${suffix}. Confirm when it is stored.",
         "settle_s": 5,
         "expect": [{"turn_resolved": true}, {"no_error_reply": true, "known_defect": "${tools_defect}", "may_pass": true},
                    {"api_min": {"path": "/api/mem/stats", "field": "vectors", "min": 1}, "known_defect": "${mem_defect}", "may_pass": "${mem_may}"},
                    {"no_fabricated_action": true}]},
        {"http": {"method": "POST", "path": "/api/orch", "form": {"clearConv": "1"}}, "expect": [{"http_status": 200}]},
        {"say": "What is my dog called?",
         "expect": [{"turn_resolved": true}, {"reply_contains": "Biscuit${suffix}", "known_defect": "${tools_defect}", "may_pass": true}, {"no_error_reply": true, "known_defect": "${tools_defect}", "may_pass": true}]}
      ]},
      {"id": "file", "steps": [
        {"say": "Save a file named shopping.txt in project home with exactly this text: milk, eggs, bread-${suffix}. Then confirm.",
         "expect": [{"turn_resolved": true}, {"no_error_reply": true, "known_defect": "${tools_defect}", "may_pass": true},
                    {"file_contains": {"project": "home", "name": "shopping.txt", "text": "bread-${suffix}"}, "known_defect": "${tools_defect}", "may_pass": true}]}
      ]},
      {"id": "restart-recovery", "needs": ["memory"], "steps": [
        {"restart": true},
        {"say": "We restarted. What is my dog called?",
         "expect": [{"turn_resolved": true}, {"reply_contains": "Biscuit${suffix}", "known_defect": "${tools_defect}", "may_pass": true}, {"no_error_reply": true, "known_defect": "${tools_defect}", "may_pass": true}]},
        {"http": {"method": "GET", "path": "/api/files/list?project=home"},
         "expect": [{"http_status": 200}, {"body_contains": "shopping.txt"}]}
      ]}
    ]
  }
}
