{
  "name": "vnp-haiku",
  "description": "Anthropic-only client: no embedding route.",
  "keys": {
    "anthropic": "ANTHROPIC_API_KEY"
  },
  "models": {
    "head": {
      "anthropic": "claude-haiku-5-5"
    },
    "sub": {
      "anthropic": "claude-haiku-5-5"
    }
  },
  "host": "anthropic",
  "timezone": "Europe/London",
  "monthly_cap_cents": 500,
  "scenarios": [
    {
      "id": "memory-honest",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/stats"
          },
          "expect": [
            {
              "body_contains": "\"embedAvailable\":false"
            }
          ]
        },
        {
          "say": "Please remember permanently: my sister's cat is called Zorblax4417. Confirm when stored.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_regex": "(?is)\\A(?!.*(?:(will|i'?ll|going to) (confirm|let you know|tell you|notify)|once (it'?s|it is|the device|that'?s|embeddings?)|(stored|saved) automatically|will be (stored|saved)|when (it'?s|it is|embeddings?) (stored|saved|work)|still pending|confirm.{0,40}(saved|stored|written))).*\\Z|no confirmation will follow"
            },
            {
              "no_error_reply": true
            }
          ]
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/lastturn"
          },
          "expect": [
            {
              "body_contains": "kept as text"
            },
            {
              "body_not_contains": "stored automatically"
            }
          ]
        },
        {
          "http": {
            "method": "POST",
            "path": "/api/orch",
            "form": {
              "clearConv": "1"
            }
          },
          "expect": [
            {
              "http_status": 200
            }
          ]
        },
        {
          "say": "What is my sister's cat called? Search your memory. Is that memory stored for good?",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_contains": "Zorblax4417"
            },
            {
              "reply_regex": "(?is)\\A(?!.*(?:(will|i'?ll|going to) (confirm|let you know|tell you|notify)|once (it'?s|it is|the device|that'?s|embeddings?)|(stored|saved) automatically|will be (stored|saved)|when (it'?s|it is|embeddings?) (stored|saved|work)|still pending|confirm.{0,40}(saved|stored|written))).*\\Z|no confirmation will follow"
            }
          ]
        }
      ]
    },
    {
      "id": "photo",
      "steps": [
        {
          "upload": {
            "project": "chat",
            "name": "sample.png",
            "png_rgb": [
              20,
              200,
              40
            ]
          },
          "expect": [
            {
              "http_status": 200
            }
          ]
        },
        {
          "say": "What color is this image? One word.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_contains": "green"
            }
          ],
          "att": [
            "chat/sample.png"
          ],
          "timeout_s": 240
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/episodic?limit=30"
          },
          "expect": [
            {
              "body_contains": "\"kind\":\"image\""
            },
            {
              "body_regex": "\\[image 1/1 ref=[0-9a-f]{16}\\] \\((seen|transcribed)"
            }
          ]
        },
        {
          "say": "What color was the photo I just sent you?",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_contains": "green"
            }
          ]
        },
        {
          "say": "Use your image tool to look at that same photo again. Is it still that color? One word for the color.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "tool_called": "image_look"
            },
            {
              "reply_contains": "green"
            }
          ],
          "timeout_s": 240
        }
      ]
    },
    {
      "id": "wakeup",
      "steps": [
        {
          "say": "Arm a wakeup for yourself in 2 minutes with the note: say WAKE-FIRED-5521. When it fires, reply with exactly that text. Use the wakeup tool now and confirm in one line.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "tool_called": "wakeup_set"
            }
          ]
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/wakeups"
          },
          "expect": [
            {
              "body_contains": "\"armed\":1"
            }
          ]
        },
        {
          "sleep": 170
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/episodic?limit=50"
          },
          "expect": [
            {
              "body_contains": "WAKE-FIRED-5521"
            }
          ]
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/log"
          },
          "expect": [
            {
              "body_regex": "loops: fired 'wakeup' ok=1|\\[WAKEUP\\]"
            }
          ]
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/wakeups"
          },
          "expect": [
            {
              "body_contains": "\"armed\":0"
            }
          ]
        }
      ]
    },
    {
      "id": "routine-fire",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/api/loops",
            "form": {
              "action": "create",
              "name": "ticker",
              "prompt": "Reply with exactly: ROUTINE-RAN-7731",
              "chatId": "owner",
              "schedule": "{\"kind\":\"interval\",\"every_seconds\":300}"
            }
          },
          "expect": [
            {
              "http_status": 200
            },
            {
              "body_contains": "\"ok\":true"
            }
          ]
        },
        {
          "sleep": 335
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/loops"
          },
          "expect": [
            {
              "body_contains": "\"lastResult\":\"ok\""
            }
          ]
        },
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/episodic?limit=50"
          },
          "expect": [
            {
              "body_contains": "ROUTINE-RAN-7731"
            }
          ]
        }
      ]
    }
  ]
}
