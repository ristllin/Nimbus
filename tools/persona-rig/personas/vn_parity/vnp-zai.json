{
  "name": "vnp-zai",
  "description": "Z.ai-only client: no embedding route and a blind head.",
  "keys": {
    "zai": "Z_AI_TOKEN"
  },
  "models": {
    "head": {
      "zai": "glm-5.3-flash"
    },
    "sub": {
      "zai": "glm-5.3-flash"
    }
  },
  "host": "zai",
  "timezone": "Europe/London",
  "monthly_cap_cents": 500,
  "scenarios": [
    {
      "id": "memory-state",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/stats"
          },
          "expect": [
            {
              "body_contains": "\"embedAvailable\":false"
            }
          ]
        }
      ]
    },
    {
      "id": "memory-honest",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/api/mem/stats"
          },
          "expect": [
            {
              "body_contains": "\"embedAvailable\":false"
            }
          ]
        },
        {
          "say": "Please remember permanently: my sister's cat is called Zorblax5521. Confirm when stored.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_regex": "(?is)\\A(?!.*(?:(will|i'?ll|going to) (confirm|let you know|tell you|notify)|once (it'?s|it is|the device|that'?s|embeddings?)|(stored|saved) automatically|will be (stored|saved)|when (it'?s|it is|embeddings?) (stored|saved|work)|still pending|confirm.{0,40}(saved|stored|written))).*\\Z|no confirmation will follow"
            },
            {
              "no_error_reply": true
            },
            {
              "write_result_regex": "kept as text"
            }
          ]
        },
        {
          "http": {
            "method": "POST",
            "path": "/api/orch",
            "form": {
              "clearConv": "1"
            }
          },
          "expect": [
            {
              "http_status": 200
            }
          ]
        },
        {
          "say": "What is my sister's cat called? Search your memory. Is that memory stored for good?",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_contains": "Zorblax5521"
            },
            {
              "reply_regex": "(?is)\\A(?!.*(?:(will|i'?ll|going to) (confirm|let you know|tell you|notify)|once (it'?s|it is|the device|that'?s|embeddings?)|(stored|saved) automatically|will be (stored|saved)|when (it'?s|it is|embeddings?) (stored|saved|work)|still pending|confirm.{0,40}(saved|stored|written))).*\\Z|no confirmation will follow"
            }
          ]
        }
      ]
    },
    {
      "id": "photo-blind",
      "steps": [
        {
          "upload": {
            "project": "chat",
            "name": "sample.png",
            "png_rgb": [
              20,
              200,
              40
            ]
          },
          "expect": [
            {
              "http_status": 200
            }
          ]
        },
        {
          "say": "What color is this image? If you cannot actually see it, say so plainly.",
          "expect": [
            {
              "turn_resolved": true
            },
            {
              "reply_regex": "(can'?t|cannot|unable|not able|couldn'?t|could not|no way).{0,80}(see|view|read|image|photo)|not read"
            },
            {
              "reply_not_contains": "green"
            }
          ],
          "att": [
            "chat/sample.png"
          ]
        }
      ]
    }
  ]
}
