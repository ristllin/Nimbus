{
 "description": "The web lookup again, on an instance that also holds a Tavily key (the portal's optional key). The known answer is read from python.org when the run starts.",
 "truth": {
  "py_latest": {
   "url": "https://www.python.org/downloads/",
   "regex": "Download Python (3\\.\\d+\\.\\d+)"
  }
 },
 "matrix": [
  {
   "name": "mistral-large-4-0",
   "host": "mistral",
   "key": "MISTRAL_API_KEY",
   "model": "mistral-large-4-0"
  },
  {
   "name": "mistral-small-latest",
   "host": "mistral",
   "key": "MISTRAL_API_KEY",
   "model": "mistral-small-latest"
  },
  {
   "name": "glm-5.3",
   "host": "zai",
   "key": "Z_AI_TOKEN",
   "model": "glm-5.3"
  },
  {
   "name": "glm-5.3-flash",
   "host": "zai",
   "key": "Z_AI_TOKEN",
   "model": "glm-5.3-flash"
  },
  {
   "name": "claude-haiku-5-5",
   "host": "anthropic",
   "key": "ANTHROPIC_API_KEY",
   "model": "claude-haiku-5-5"
  },
  {
   "name": "gpt-6-luna",
   "host": "openai",
   "key": "OPENAI_API_KEY",
   "model": "gpt-6-luna"
  }
 ],
 "persona": {
  "name": "tav-${name}",
  "keys": {
   "${host}": "${key}"
  },
  "instance_env_keys": [
   "TAVILY_API_KEY"
  ],
  "models": {
   "head": {
    "${host}": "${model}"
   },
   "sub": {
    "${host}": "${model}"
   }
  },
  "host": "${host}",
  "monthly_cap_cents": 100,
  "scenarios": [
   {
    "id": "web",
    "steps": [
     {
      "say": "Use a web lookup to find the latest stable Python 3 release listed on python.org/downloads. Tell me the version number and the URL you used.",
      "timeout_s": 300,
      "settle_s": 5,
      "expect": [
       {
        "turn_resolved": true
       },
       {
        "reply_contains": "${py_latest}",
        "known_defect": "web-answer-quality",
        "may_pass": true
       },
       {
        "no_error_reply": true,
        "known_defect": "placeholder-reply",
        "may_pass": true
       },
       {
        "tool_called": "web_search",
        "known_defect": "glm-no-tools",
        "may_pass": true
       }
      ]
     }
    ]
   }
  ]
 }
}
