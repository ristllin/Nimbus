{
 "description": "Is a GLM head's lost memory write an embeddings problem? This instance holds a Mistral key too, so embeddings work. If the writes still do not land, the cause is the head's output, not the route.",
 "matrix": [
  {
   "model": "glm-5.3"
  },
  {
   "model": "glm-5.3-flash"
  }
 ],
 "persona": {
  "name": "glm-cause-${model}",
  "keys": {
   "zai": "Z_AI_TOKEN",
   "mistral": "MISTRAL_API_KEY"
  },
  "models": {
   "head": {
    "zai": "${model}"
   },
   "sub": {
    "zai": "${model}"
   }
  },
  "host": "zai",
  "monthly_cap_cents": 100,
  "scenarios": [
   {
    "id": "writes",
    "steps": [
     {
      "http": {
       "method": "GET",
       "path": "/api/mem/stats"
      },
      "expect": [
       {
        "http_status": 200
       },
       {
        "body_contains": "\"embedAvailable\":true"
       }
      ]
     },
     {
      "say": "Please remember permanently: fact number $i is that my locker code is 88$i. Confirm when stored.",
      "repeat": 3,
      "settle_s": 5,
      "expect": [
       {
        "turn_resolved": true
       },
       {
        "log_regex": "mem_write outcomes stored=[1-9]",
        "known_defect": "glm-mem-write-dropped",
        "may_pass": true
       },
       {
        "api_min": {
         "path": "/api/mem/stats",
         "field": "vectors",
         "min": 1
        },
        "known_defect": "glm-mem-write-dropped",
        "may_pass": true
       }
      ]
     }
    ]
   }
  ]
 }
}
