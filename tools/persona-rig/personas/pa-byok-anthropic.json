{
  "description": "BYOK on Anthropic alone: only an Anthropic key, so memory has no embedding route (queued, not stored) and web has no Tavily key. Chat, memory honesty, a file, a sub-agent.",
  "vars": {"suffix": "2260"},
  "matrix": [
    {"name": "claude-haiku-5-5", "host": "anthropic", "key": "ANTHROPIC_API_KEY", "model": "claude-haiku-5-5"}
  ],
  "persona": {
    "name": "pa-byok-anthropic-${name}",
    "display_name": "June's Nimbus",
    "timezone": "America/New_York",
    "monthly_cap_cents": 400,
    "keys": {"${host}": "${key}"},
    "models": {"head": {"${host}": "${model}"}, "sub": {"${host}": "${model}"}},
    "host": "${host}",
    "scenarios": [
      {"id": "chat", "steps": [
        {"say": "What is 7 times 8? Answer with just the number.",
         "expect": [{"turn_resolved": true}, {"reply_regex": "\\b56\\b"}, {"no_error_reply": true}]}
      ]},
      {"id": "memory-honesty", "steps": [
        {"http": {"method": "GET", "path": "/api/mem/stats"},
         "expect": [{"http_status": 200}, {"body_contains": "\"embedAvailable\":false"}]},
        {"say": "Please remember permanently: my anniversary is on the 14th of June-${suffix}. Confirm when it is stored.",
         "settle_s": 5,
         "expect": [{"turn_resolved": true}, {"no_error_reply": true}, {"no_fabricated_action": true},
                    {"api_min": {"path": "/api/mem/stats", "field": "vectors", "min": 1}, "known_defect": "memory-needs-mistral-key", "may_pass": true}]},
        {"http": {"method": "POST", "path": "/api/orch", "form": {"clearConv": "1"}}, "expect": [{"http_status": 200}]},
        {"say": "When is my anniversary?",
         "expect": [{"turn_resolved": true}, {"reply_nonempty": true}, {"no_error_reply": true}]}
      ]},
      {"id": "file-and-spawn", "steps": [
        {"say": "Save a file named ideas.txt in project art with exactly: mural-${suffix}. Then confirm.",
         "expect": [{"turn_resolved": true}, {"no_error_reply": true},
                    {"file_contains": {"project": "art", "name": "ideas.txt", "text": "mural-${suffix}"}}]},
        {"say": "Start a sub-agent to work out the 13th Fibonacci number. Do not work it out yourself. Report what it found.",
         "await_reply_regex": "\\b233\\b", "timeout_s": 300, "settle_s": 5,
         "expect": [{"turn_resolved": true}, {"log_regex": "spawned job"}, {"reply_regex": "\\b233\\b"}, {"no_error_reply": true}]}
      ]},
      {"id": "web-no-tavily", "steps": [
        {"say": "Use a web lookup to find the latest stable Python 3 release on python.org/downloads. Tell me the version and the URL you used.",
         "timeout_s": 300, "settle_s": 30,
         "expect": [{"turn_resolved": true}, {"reply_contains": "${py_latest}", "known_defect": "no-web-lookup", "may_pass": true}, {"no_error_reply": true, "known_defect": "placeholder-reply", "may_pass": true}]}
      ]}
    ]
  },
  "truth": {"py_latest": {"url": "https://www.python.org/downloads/", "regex": "Download Python (3\\.\\d+\\.\\d+)"}}
}
